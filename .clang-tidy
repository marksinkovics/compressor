# Left out for good: easily-swappable-parameters and use-nodiscard flag nearly every function,
# and trailing return types are a style choice we don't make.
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  performance-*,
  modernize-*,
  -bugprone-easily-swappable-parameters,
  -modernize-use-nodiscard,
  -modernize-use-trailing-return-type
WarningsAsErrors: '*'
# vcpkg ports are installed under build/ and come in as system headers.
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '.*/build/.*'
FormatStyle: file
